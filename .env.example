# 이 파일을 .env.local 로 복사해서 값을 채운다. (.env.local 은 GitHub에 안 올라감)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANTHROPIC_API_KEY=

# 선택: 채점 모델 (기본 claude-opus-5-5, 싸게 가려면 claude-haiku-5-5)
SCORE_MODEL=
# 선택: 조롱 LLM(한줄평 다시 뽑기) 전용 모델. 비우면 SCORE_MODEL과 같음 (예: claude-haiku-5-5 로 싸게)
ROAST_MODEL=
# 선택: 하루 채점 제한 (사진 장수 기준)
DAILY_SCORE_LIMIT=20
ANON_DAILY_SCORE_LIMIT=6
# 선택: 키 없이 화면만 테스트할 때 1 (가짜 점수)
MOCK_SCORING=
# 선택: 네이버 로그인 버튼 켜기 (Supabase Custom Provider 설정 후 1)
NEXT_PUBLIC_NAVER_LOGIN=
# 선택: 카카오톡 공유 (Kakao Developers의 JavaScript 키, 공개용 키)
NEXT_PUBLIC_KAKAO_JS_KEY=
